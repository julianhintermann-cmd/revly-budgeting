# revly-budgeting configuration (all optional – sane defaults built in)

# Database: SQLite file inside the /data volume by default.
# Postgres: postgresql+asyncpg://user:pass@host:5432/dbname  (postgres:// also works)
#DATABASE_URL=sqlite+aiosqlite:////data/revly.db

# Secret for JWT signing. If unset, a key is generated once and persisted in DATA_DIR.
#SECRET_KEY=

# Where the SQLite DB, generated secret and receipt uploads live.
#DATA_DIR=/data
#UPLOAD_DIR=/data/uploads

# Comma-separated list of extra allowed CORS origins (same-origin needs none).
#ALLOWED_ORIGINS=

# de or en – locale used for scheduler-generated notifications.
#DEFAULT_LOCALE=de

# Token lifetimes
#ACCESS_TOKEN_MINUTES=15
#REFRESH_TOKEN_DAYS=30

# SMTP fallback config (the admin area in the app overrides these).
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=revly@example.com
#SMTP_USE_TLS=true

# How often the recurring-transaction scheduler wakes up (seconds).
#SCHEDULER_INTERVAL_SECONDS=3600
